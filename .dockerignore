# Build-context excludes for the root-context Railway build
# (deploy/railway/Dockerfile). Only excludes things the build regenerates
# or never needs — do NOT exclude docker/release/*, it holds runtime config
# the Dockerfile COPYs.
.git
.gitlab
**/node_modules
/vendor
# host-only local dev artifacts
tmp/
*.log
# local secret env files — must never enter the build context
# (.env.example is a tracked template and is deliberately kept)
/.env
/.env.*
!/.env.example
